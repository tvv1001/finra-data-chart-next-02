{
	"name": "finra-data-chart-next-02",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bash scripts/start-local-redis.sh && NODE_OPTIONS=--max-old-space-size=8192 next dev -p 4444",
		"dev:clean": "bash scripts/start-local-redis.sh && rm -rf .next && next dev -p 4444",
		"redis:start": "bash /home/lenny/Dev/db/redis/start-redis.sh",
		"redis:commander": "npx --yes redis-commander --noload --nosave --redis-host 127.0.0.1 --redis-port 6379 --redis-db 0 --redis-label local --address 127.0.0.1 --port 8081",
		"prebuild": "node scripts/prebuild.js",
		"build:workers": "node scripts/build_workers.js",
		"build:wasm": "cd rust/graph-layout && wasm-pack build --target web --out-dir ../../public/wasm/graph-layout",
		"build:wasm:release": "cd rust/graph-layout && wasm-pack build --release --target web --out-dir ../../public/wasm/graph-layout",
		"build:wasm:parallel": "cd rust/graph-layout && wasm-pack build --release --target web --out-dir ../../public/wasm/graph-layout -- --features parallel",
		"optimize:wasm": "sh -c \"if command -v wasm-opt >/dev/null 2>&1; then wasm-opt -O3 --vacuum public/wasm/graph-layout/*_bg.wasm -o public/wasm/graph-layout/opt.wasm && mv public/wasm/graph-layout/opt.wasm public/wasm/graph-layout/*_bg.wasm; else echo 'wasm-opt not found; skipping optimization'; fi\"",
		"wasm:ci-build": "pnpm run build:wasm:release && pnpm run optimize:wasm || true",
		"build:search-index": "node scripts/build_search_indexes.js",
		"build:deploy-artifacts": "node scripts/build_graph_from_cache.js --employment-scope all --no-redis && node scripts/build_search_indexes.js && ENABLE_PRIMED_CACHE=true node scripts/build_primed_cache_bundle.js",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/build_search_indexes.js && NODE_OPTIONS=--max-old-space-size=8192 next build --webpack && node scripts/copy-search-indexes.js",
		"start": "NODE_OPTIONS=--max-old-space-size=8192 next start -p 4444",
		"lint": "next lint",
		"test:e2e": "playwright test",
		"test:unit": "vitest",
		"test:e2e:headed": "playwright test --headed",
		"test:smoke": "playwright test tests/e2e/smoke.spec.ts",
		"build:graph": "node scripts/build_graph_from_cache.js --employment-scope all",
		"build:primed-cache": "ENABLE_PRIMED_CACHE=true node scripts/build_primed_cache_bundle.js",
		"build:firm-emp-adj": "node scripts/build_firm_employment_adj.mjs",
		"build:people-clusters": "node scripts/build_people_clusters.js",
		"push:firm-connections:all": "node scripts/push_all_firm_connections_to_redis.mjs",
		"push:firm-connections:watch": "node scripts/watch_and_push_firm_connections.mjs",
		"crd-log": "node scripts/generate-crd-log.js",
		"split:crds": "node scripts/split_crds_into_batches.js",
		"deploy:primed-cache": "pnpm run build:primed-cache && PEOPLE_CLUSTER_ALLOW_MISSING_GRAPH=true pnpm run build:people-clusters && node scripts/deploy_primed_cache_to_redis.js",
		"deploy:graph": "node scripts/deploy_graph_upstash.js",
		"deploy:search-indexes": "node scripts/deploy-search-indexes-to-redis.js",
		"deploy:upstash-artifacts": "pnpm run build:deploy-artifacts && pnpm run deploy:graph && pnpm run deploy:search-indexes && node scripts/deploy_primed_cache_to_redis.js",
		"deploy:redis-cache": "node scripts/import_local_cache.js",
		"deploy:redis-cache:batch": "node scripts/import_local_cache.js --crd-file \"$CRD_BATCH_FILE\"",
		"redis:prune-invalid-sources": "node scripts/prune_invalid_source_cache.js",
		"redis:prune-invalid-sources:apply": "node scripts/prune_invalid_source_cache.js --apply",
		"vercel:pull": "vercel pull --yes --environment=production",
		"vercel:build": "NODE_OPTIONS=--max-old-space-size=16384 vercel build --prod",
		"vercel:deploy:prebuilt": "vercel deploy --prebuilt --prod",
		"vercel:deploy": "pnpm run vercel:pull && pnpm run vercel:build && pnpm run vercel:deploy:prebuilt",
		"vercel-build": "pnpm run build",
		"prime:all": "node scripts/download_all_api_data.js",
		"ci:install-browsers": "npx playwright install --with-deps || npx playwright install chromium"
	},
	"dependencies": {
		"@upstash/redis": "^1.37.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"axios": "^1.7.2",
		"bottleneck": "^2.19.5",
		"chokidar": "^5.0.0",
		"d3": "^7.9.0",
		"d3-force": "^3.0.0",
		"ioredis": "^6.0.0",
		"minimist": "^1.2.8",
		"msgpack-lite": "^0.1.26",
		"next": "^16.2.9",
		"pixi.js": "^8.4.0",
		"playwright-extra-plugin-stealth": "^0.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"winston": "^3.13.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@testing-library/dom": "^9.0.0",
		"@types/d3": "^7.4.3",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^20.19.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.0.0",
		"eslint-config-next": "^16.2.9",
		"jsdom": "^22.1.0",
		"playwright": "^1.60.0",
		"playwright-extra": "^4.3.6",
		"sharp": "^0.34.5",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.0",
		"vitest": "^1.1.7"
	}
}
