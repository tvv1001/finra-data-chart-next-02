+					iaScope: src?.ind_ia_scope ?? parsed?.basicInformation?.iaScope ?? null,
+					disclosureFlag,
+					iaDisclosureFlag,
+					_source: 'finra',
+				});
+
+				// Link to current employments
+				const emps = src?.ind_current_employments || src?.ind_ia_current_employments || [];
+				for (const e of emps) {
