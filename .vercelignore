# Prevent shipping curated seed lists and primed cache bundles to Vercel deployments

data/seed-profiles.json /data/national/primed-cache/\*\* data/national/finra-seed-bank.json data/national/finra-recent-seeds.json

# Also exclude large cache artifacts that are not required for runtime

/data/national/_.bak_ /data/cache-binary/_ /node*modules/ /.next/ /coverage/ /dist/ /build/ /.DS_Store /Thumbs.db /.env* _.log /.vercel/ /data/ /tests/ /test-results/ /playwright-report/
